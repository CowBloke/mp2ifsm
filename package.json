{
  "name": "mp2ifsm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4260 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 4260 -H 127.0.0.1",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "db:reconcile": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/reconcile.sql",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "deposits:sync": "node --experimental-strip-types scripts/sync-deposits.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "jeu:dev": "tsx watch jeu/serveur/main.ts",
    "jeu:test": "node --import tsx --test jeu/tests/*.test.ts",
    "jeu:equilibrage": "tsx jeu/outils/equilibrage.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "katex": "^0.18.7",
    "next": "15.5.4",
    "pg": "8.16.3",
    "pixi.js": "^8.21.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.2",
    "ws": "^8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/ws": "^8.18.1",
    "tailwindcss": "4.1.13",
    "tsx": "^4.23.13",
    "typescript": "5.9.2"
  }
}
