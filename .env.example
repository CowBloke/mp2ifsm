# --- Base de donnees -------------------------------------------------
DATABASE_URL=postgresql://mp2ifsm:CHANGEME@127.0.0.1:5432/mp2ifsm

# --- Sessions --------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=CHANGEME

# --- Origine publique ------------------------------------------------
PUBLIC_ORIGIN=https://mp2ifsm.com

# --- Source externe des depots --------------------------------------
# Adaptateur utilise pour crediter les comptes. "mock" sert aux tests et
# ne credite rien de reel. Voir src/lib/external.ts pour brancher l'API
# reelle du site de la classe.
DEPOSIT_PROVIDER=mock
DEPOSIT_API_BASE=
DEPOSIT_API_TOKEN=

# Jeton partage protegeant /api/cron/sync-deposits (appele par cron).
CRON_TOKEN=CHANGEME

# Documents et images : fichiers privés sur le SSD, plafonds en octets.
STORAGE_ROOT=/home/cowbloke/mp2ifsm-data
QUOTA_UTILISATEUR=524288000
QUOTA_GLOBAL=21474836480
TAILLE_MAX_FICHIER=52428800

# --- Jeu (prototype) --------------------------------------------------
# Ouvre /jeu : "tous" (membres) ou "admins" ; vide, la page n'existe pas.
JEU_ACTIF=
# Port local du serveur de jeu (npm run jeu:dev), derrière nginx en prod.
JEU_PORT=4270
# En développement seulement : URL du serveur de jeu vue par le navigateur.
# En production, laisser vide : même origine, via nginx (/ws/jeu).
JEU_WS_URL=
